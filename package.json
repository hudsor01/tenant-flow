{
	"$schema": "https://json.schemastore.org/package",
	"name": "tenantflow",
	"private": true,
	"version": "1.0.1",
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"engines": {
		"node": "24.x",
		"bun": "1.3.x"
	},
	"packageManager": "bun@1.3.14",
	"imports": {
		"#proxy": "./src/proxy.ts",
		"#env": "./src/env.ts",
		"#app/*": "./src/app/*",
		"#components/*": "./src/components/*",
		"#lib/*": "./src/lib/*",
		"#hooks/*": "./src/hooks/*",
		"#stores/*": "./src/stores/*",
		"#types/*": "./src/types/*",
		"#providers/*": "./src/providers/*",
		"#test/*": "./src/test/*",
		"#config/*": "./src/config/*"
	},
	"scripts": {
		"dev": "next dev --port 3050",
		"build": "next build",
		"start": "next start",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tests/integration/tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json",
		"test": "vitest",
		"test:unit": "vitest --run --project unit",
		"test:component": "vitest --run --project component --passWithNoTests",
		"test:integration": "vitest --run --project integration",
		"test:rls": "vitest --run --project integration",
		"test:ci": "CI=true vitest --run",
		"test:e2e": "bunx playwright test --config tests/e2e/playwright.config.ts",
		"clean": "rm -rf .next",
		"db:push": "supabase db push && bun run db:types",
		"db:pull": "supabase db pull",
		"db:reset": "supabase db reset && bun run db:types",
		"db:types": "bash scripts/db-types.sh",
		"validate": "bun run clean && bun run typecheck && bun run lint && bun run test:unit",
		"validate:quick": "bun run typecheck && bun run lint && bun run test:unit",
		"detect:types": "./scripts/check-duplicate-types.sh",
		"health": "bash scripts/health-check.sh",
		"changelog": "git cliff --output CHANGELOG.md",
		"scan:secrets": "gitleaks detect --source . --no-git -v",
		"prepare": "git rev-parse --is-inside-work-tree > /dev/null 2>&1 && lefthook install || true"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"overrides": {
		"postcss-selector-parser": "^7.1.6"
	},
	"trustedDependencies": [
		"@sentry/cli",
		"esbuild",
		"lefthook",
		"msw",
		"sharp",
		"supabase"
	],
	"dependencies": {
		"@diceui/combobox": "2.0.0",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/modifiers": "9.0.0",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@floating-ui/react-dom": "^2.1.9",
		"@sentry/nextjs": "^10.76.2",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.117.2",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-query-persist-client": "^5.104.5",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/react-virtual": "^3.14.21",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"dompurify": "^3.4.17",
		"geist": "^1.8.1",
		"idb-keyval": "^6.3.0",
		"input-otp": "^1.5.0",
		"jspdf": "4.2.1",
		"jspdf-autotable": "5.0.8",
		"lucide-react": "^1.60.0",
		"next": "16.4.2",
		"next-themes": "^0.4.6",
		"nuqs": "^2.10.2",
		"papaparse": "^5.7.0",
		"radix-ui": "^1.8.1",
		"react": "19.3.1",
		"react-day-picker": "^10.0.1",
		"react-dom": "19.3.1",
		"react-dropzone": "^20.1.1",
		"react-error-boundary": "^6.1.6",
		"react-markdown": "^10.1.0",
		"recharts": "^3.10.1",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"sharp": "^0.35.5",
		"sonner": "^2.0.8",
		"stripe": "^23.0.1",
		"tailwind-merge": "^3.7.0",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"zod": "^4.6.7",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.14",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@faker-js/faker": "^10.6.0",
		"@playwright/test": "1.62.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.1.1",
		"@types/papaparse": "^5.5.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/coverage-v8": "^4.1.12",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv": "^18.0.4",
		"fast-check": "^4.8.0",
		"jsdom": "^30.0.0",
		"knip": "^6.13.1",
		"lefthook": "^2.1.14",
		"msw": "2.15.0",
		"playwright": "1.62.0",
		"playwright-core": "1.62.0",
		"postcss": "^8.5.29",
		"schema-dts": "^2.0.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^4.1.12",
		"yaml": "^2.9.1"
	}
}
